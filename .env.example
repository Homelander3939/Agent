# Copy to .env and fill in only the cloud providers you actually enabled
# in config.yaml. Local-only usage (Ollama/LM Studio) needs no keys at all.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only needed if you turned on "API key" auth in LM Studio's Local Server
# settings. Leave blank for the default no-auth local server.
LMSTUDIO_API_KEY=
